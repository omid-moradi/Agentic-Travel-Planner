# ==============================================================================
# Agentic Travel Planner - environment template
# Copy to .env and fill in.  NEVER commit a real .env file.
#     cp .env.example .env
# Every value below is a placeholder. The app must run end-to-end in demo mode
# with LLM_PROVIDER=mock and all provider chains pointing at fixture/curated.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM gateway (provider-agnostic) - see docs/decisions.md ADR-003
# ------------------------------------------------------------------------------
# LLM_PROVIDER: apmix | openai | openai_compatible | ollama | mock
LLM_PROVIDER=apmix
LLM_BASE_URL=https://api.apmix.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash-free
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
# Optional: separate cheaper model for extraction tasks (model routing, phase 6)
LLM_EXTRACTION_MODEL=
# Local Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Legacy prototype settings (kept only while legacy_prototype/ exists)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
DEFAULT_LANGUAGE=fa
SUPPORTED_LANGUAGES=fa,en
DEFAULT_REGION=iran
# Identifiable scraper User-Agent - include a real contact URL (required by robots etiquette)
SCRAPER_USER_AGENT=AgenticTravelPlannerBot/0.1 (+https://github.com/omid-moradi/Agentic-Travel-Planner)
SCRAPER_RATE_LIMIT_PER_SECOND=0.5
SCRAPER_RESPECT_ROBOTS=true

# ------------------------------------------------------------------------------
# Database / cache  (ADR-005: sqlite fallback for tests, postgres in production)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/travel_planner
REDIS_URL=
CACHE_TTL_PRICES_SECONDS=10800
CACHE_TTL_PLACE_INFO_SECONDS=259200

# ------------------------------------------------------------------------------
# Provider chains - comma separated, first success wins (phase 3)
# ------------------------------------------------------------------------------
# Available implementations per capability:
#   scraper_*  responsible scraping behind the shared ScraperClient
#   api_*      reserved for official APIs (disabled until a partner exists)
#   curated    checked-in dataset with last_verified_at
#   estimator  formula-based fallback, always labelled "estimated"
#   fixture    recorded responses for offline tests
HOTELS_PROVIDERS=curated,estimator
TRANSPORT_PROVIDERS=curated,estimator
RESTAURANTS_PROVIDERS=curated,estimator
RIDE_FARE_PROVIDERS=estimator
PLACES_PROVIDERS=fixture,curated
WEATHER_PROVIDERS=open_meteo
CURRENCY_PROVIDERS=exchangerate_host
ROUTES_PROVIDERS=osrm
GEOCODE_PROVIDERS=nominatim
EVENTS_PROVIDERS=fixture,curated

# ------------------------------------------------------------------------------
# Maps / routing (self-hostable OpenStreetMap stack by default)
# ------------------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=
# Optional Iran-focused map providers, enabled only when a key is present
NESHAN_API_KEY=
BALAD_API_KEY=

# ------------------------------------------------------------------------------
# Search
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
SEARCH_PROVIDERS=tavily

# ------------------------------------------------------------------------------
# Monetization (phase 6) - test mode only, never store card data
# ------------------------------------------------------------------------------
BILLING_ENABLED=false
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ENABLE_IRAN_GATEWAY=false

# Affiliate ids (redirect only - the agent never books or pays)
AFFILIATE_HOTELS_ID=
AFFILIATE_FLIGHTS_ID=
AFFILIATE_ACTIVITIES_ID=

# ------------------------------------------------------------------------------
# Auth (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=                  # HS256 secret; MUST be set in production
ACCESS_TOKEN_EXPIRY_MINUTES=1440
ADMIN_BOOTSTRAP_EMAIL=       # the first account with this email becomes admin

# ------------------------------------------------------------------------------
# Entitlements / usage
# ------------------------------------------------------------------------------
FREE_TIER_PLANS_PER_MONTH=3
PRO_TIER_PLANS_PER_MONTH=50
GUEST_TRIAL_ENABLED=true
MAX_REPAIR_LOOPS=2
MAX_TOOL_CALLS_PER_RUN=40
